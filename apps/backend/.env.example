PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Se o backend roda fora do Docker falando com um n8n publicado localmente, use
# http://localhost:5678/... Se o backend roda dentro do mesmo docker-compose que o
# serviço n8n, use http://n8n:5678/... (nome do serviço). Os workflows precisam estar
# ativados no n8n para responder em /webhook/... em vez de /webhook-test/...
N8N_EXTRACTION_WEBHOOK_URL=http://localhost:5678/webhook-test/extracao
N8N_FEEDBACK_WEBHOOK_URL=http://localhost:5678/webhook-test/feedback-sti
N8N_EXTRACTION_FILE_FIELD=image
UPLOAD_MAX_SIZE_MB=10
N8N_TIMEOUT_MS=120000
