# =============================================================================
# .env de PRODUCAO (droplet DigitalOcean).
# No servidor: cp .env.production.example .env  e preencha os valores reais.
# O .env real NUNCA vai para o git (ja esta no .gitignore).
# =============================================================================

# --- Backend -----------------------------------------------------------------
PORT=3001
NODE_ENV=production

# Origem publica da aplicacao. Frontend e API ficam na MESMA origem (o nginx do
# container frontend faz proxy de /api), entao basta um valor aqui.
# Fase 1 (so IP):    http://143.198.0.0
# Fase 2 (dominio):  https://sti.seudominio.com.br
FRONTEND_ORIGIN=http://SEU_IP_OU_DOMINIO

# "/" faz o frontend chamar caminhos relativos (/api/...). NAO troque por
# http://IP:3001 -- a porta 3001 nao fica mais publicada em producao.
VITE_API_BASE_URL=/

# --- Integracao com o n8n ----------------------------------------------------
# "n8n" e o nome do servico na rede interna do Compose (nao use localhost).
# ATENCAO: em producao os workflows precisam estar ATIVOS no n8n, e ai o caminho
# passa a ser /webhook/... (sem o "-test"). Com o workflow desativado, so
# /webhook-test/... responde, e apenas para uma unica chamada apos clicar em
# "Listen for test event".
N8N_EXTRACTION_WEBHOOK_URL=http://n8n:5678/webhook/extracao-otimizado
N8N_FEEDBACK_WEBHOOK_URL=http://n8n:5678/webhook/feedback-sti
N8N_EXTRACTION_FILE_FIELD=image
UPLOAD_MAX_SIZE_MB=10
N8N_TIMEOUT_MS=120000

# --- Servico n8n -------------------------------------------------------------
# Copie EXATAMENTE o valor de "encryptionKey" de n8n_data/config. Se divergir,
# o n8n nao sobe ("Mismatching encryption keys") e as credenciais do Gemini
# ficam ilegiveis. Nunca altere depois que houver dados salvos.
N8N_ENCRYPTION_KEY=cole-aqui-a-chave-que-esta-em-n8n_data/config

# Fixe a versao do n8n (a mesma que roda na maquina local). "latest" pode subir
# uma versao nova e rodar migrations irreversiveis no n8n_data/.
N8N_IMAGE_TAG=2.35.7

N8N_HOST=SEU_IP_OU_DOMINIO
N8N_PROTOCOL=http
WEBHOOK_URL=http://SEU_IP_OU_DOMINIO:5678/
N8N_EDITOR_BASE_URL=http://SEU_IP_OU_DOMINIO:5678/

# Em HTTP puro (Fase 1) o cookie de sessao precisa ser nao-seguro, senao o login
# no editor do n8n falha com "Your browser doesn't support secure cookies".
# Na Fase 2 (HTTPS) o docker-compose.tls.yml sobrescreve isso para true.
N8N_SECURE_COOKIE=false

N8N_RUNNERS_ENABLED=true
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# --- Fase 2: HTTPS com dominio (docker-compose.tls.yml) ----------------------
# APP_DOMAIN=sti.seudominio.com.br
# N8N_DOMAIN=n8n.seudominio.com.br
# ACME_EMAIL=seu-email@exemplo.com
