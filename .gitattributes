# Normaliza fim de linha: o repo guarda LF, o checkout no Windows pode ser CRLF.
# Sem isso, salvar um arquivo no Windows aparece como "arquivo inteiro alterado".
* text=auto eol=lf

*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.pptx binary
