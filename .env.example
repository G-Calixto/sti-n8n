PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Se o backend roda fora do Docker (npm run dev:backend) falando com um n8n publicado
# localmente, use http://localhost:5678/... Se o backend roda dentro do mesmo
# docker-compose que o serviço n8n (deploy via docker/docker-compose.prod.yml), use
# http://n8n:5678/... (nome do serviço na rede interna do Compose). Os workflows
# precisam estar ativados no n8n para responder em /webhook/... em vez de /webhook-test/...
N8N_EXTRACTION_WEBHOOK_URL=http://localhost:5678/webhook-test/extracao
N8N_FEEDBACK_WEBHOOK_URL=http://localhost:5678/webhook-test/feedback-sti
N8N_EXTRACTION_FILE_FIELD=image
UPLOAD_MAX_SIZE_MB=10
N8N_TIMEOUT_MS=120000
VITE_API_BASE_URL=http://localhost:3001

# Configuração do serviço n8n (usado por docker/docker-compose.dev.yml e prod.yml)
# N8N_ENCRYPTION_KEY deve ser a MESMA chave já usada para gerar os dados existentes em
# n8n_data/ — trocar o valor torna credenciais/workflows já salvos ilegíveis.
N8N_ENCRYPTION_KEY=troque-por-uma-chave-forte-e-nunca-a-altere-depois
# Em produção (droplet), aponte estes três para o domínio/IP público real, já que o
# editor do n8n fica exposto na internet.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
